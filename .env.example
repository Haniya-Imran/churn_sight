# ChurnSight backend settings. Copy to `.env` and adjust. No secrets are required.
CHURNSIGHT_APP_ENV=development
# Folder containing the trained model artifacts.
CHURNSIGHT_MODELS_DIR=./models
# Comma-separated browser origins allowed to call the API (no wildcard).
CHURNSIGHT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Maximum request body size in bytes.
CHURNSIGHT_MAX_BODY_BYTES=16384
CHURNSIGHT_LOG_LEVEL=INFO
